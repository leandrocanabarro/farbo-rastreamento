# ---------------------------------------------------------------------------
# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
# ---------------------------------------------------------------------------

APP_ENV=production

# --- Portas expostas na máquina ---
HTTP_PORT=8080
# Porta em que os rastreadores conectam. Tem de estar acessível pela internet.
TCP_PORT=5000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- Banco ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=troque-esta-senha

# --- Redis (opcional: replica eventos entre instâncias) ---
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379

# --- Autenticação ---
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-de-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Primeiro usuário, criado só quando o banco está vazio.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=uma-senha-com-10-ou-mais-caracteres
ADMIN_NAME=Administrador

# --- Origem permitida no navegador ---
CORS_ORIGINS=http://localhost:3000

# --- Regra de segurança do corte de motor ---
# Acima desta velocidade o corte é RECUSADO pelo backend.
ENGINE_CUT_MAX_SPEED_KMH=5
# Posição mais velha que isto também recusa o corte.
ENGINE_CUT_MAX_POSITION_AGE=10m
# Sem ACK neste prazo, o comando vira TIMEOUT.
COMMAND_ACK_TIMEOUT=15s

# --- Estado online/offline ---
DEVICE_STALE_AFTER=2m
DEVICE_OFFLINE_AFTER=5m

# --- Limites do histórico ---
HISTORY_MAX_POINTS=5000
HISTORY_SIMPLIFY_TOLERANCE_M=5

# --- Velocidade ---
# 0 desliga o alerta global; cada veículo pode ter o seu próprio limite.
DEFAULT_SPEED_LIMIT_KMH=0
OVERSPEED_HYSTERESIS_KMH=5

# --- Rede dos rastreadores ---
TCP_MAX_PACKET_SIZE=8192
TCP_READ_TIMEOUT=10m
TCP_MAX_CONNECTIONS=10000

# --- Protocolos ---
# Responder também aos pacotes de posição do GT06 (só se o aparelho exigir).
GT06_ACK_GPS=false
# Tamanho do quadro binário do H02. O protocolo não tem terminador nem campo
# de tamanho: 0 usa a heurística de um quadro por leitura TCP. Depois de ver o
# tamanho real do seu aparelho (campo frameBytes na posição), fixe aqui.
H02_BINARY_FRAME_LENGTH=0
# Captura de tráfego não identificado, para descobrir a variante do aparelho.
TKSTAR_V4_CAPTURE=false

# --- Observabilidade ---
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MASK_IMEI=true
# Vazio desliga o tracing distribuído.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1

GRAFANA_PASSWORD=admin
